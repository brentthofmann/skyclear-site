# Skyclear environment variables — copy to .env.local and fill in.
# No secrets are committed; .env.local is gitignored.

# Lead form → SMS. Brent creates a Zapier "Catch Hook" (Webhooks by Zapier),
# connects it to an SMS step, and pastes the catch-hook URL here.
# Swap to a Twilio endpoint later by changing only this value + the fetch in quote-form.tsx.
NEXT_PUBLIC_ZAPIER_WEBHOOK_URL=

# (Later) invisible reCAPTCHA v3 site key for spam protection.
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
